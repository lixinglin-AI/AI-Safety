%% neurips_2025.sty — Official NeurIPS 2025 style file (for Overleaf)
%%
%% Based on the official NeurIPS LaTeX template.
%% Options: final, preprint, nonatbib

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{neurips_2025}[2025/01/15 NeurIPS 2025 submission/camera-ready style]

% Declare options
\newif\if@neuripsfinal\@neuripsfinalfalse
\newif\if@neuripspreprint\@neuripspreprintfalse
\newif\if@neuripsnonatbib\@neuripsnonatbibfalse

\DeclareOption{final}{\@neuripsfinaltrue}
\DeclareOption{preprint}{\@neuripspreprinttrue}
\DeclareOption{nonatbib}{\@neuripsnonatbibtrue}
\ProcessOptions\relax

% Fonts
\renewcommand{\rmdefault}{ptm}
\renewcommand{\sfdefault}{phv}

% Page geometry
\usepackage[verbose=true,letterpaper]{geometry}
\AtBeginDocument{
  \newgeometry{
    textheight=9in,
    textwidth=5.5in,
    top=1in,
    headheight=12pt,
    headsep=25pt,
    footskip=30pt
  }
}

% Line numbers for review
\if@neuripsfinal\else
  \if@neuripspreprint\else
    \usepackage{lineno}
    \linenumbers
  \fi
\fi

% natbib
\if@neuripsnonatbib\else
  \RequirePackage{natbib}
\fi

% Header / footer
\usepackage{fancyhdr}
\fancyhf{}
\if@neuripsfinal
  \fancyhead[C]{\small 39th Conference on Neural Information Processing Systems (NeurIPS 2025)}
\else
  \if@neuripspreprint
    \fancyhead[C]{\small Preprint. Work in progress.}
  \else
    \fancyhead[C]{\small Submitted to 39th Conference on Neural Information Processing Systems (NeurIPS 2025). Do not distribute.}
  \fi
\fi
\fancyfoot[C]{\thepage}
\pagestyle{fancy}
\renewcommand{\headrulewidth}{0pt}

% Title
\newcommand{\@neuripsmaketitle}{%
  \vbox{%
    \hsize\textwidth
    \linewidth\hsize
    \vskip 0.25in
    {\centering
      {\LARGE\bfseries \@title \par}
      \vskip 0.3in
      \if@neuripsfinal
        {\large\@author\par}
      \else
        \if@neuripspreprint
          {\large\@author\par}
        \else
          {\large
            Anonymous Author(s)\\
            Affiliation\\
            Address\\
            \texttt{email}
          \par}
        \fi
      \fi
      \vskip 0.3in
    }%
  }%
}
\let\old@maketitle\maketitle
\renewcommand{\maketitle}{\@neuripsmaketitle}

% Abstract
\renewenvironment{abstract}{%
  \centerline{\large\bfseries Abstract}
  \vspace{0.5ex}
  \begin{quote}
}{%
  \par
  \end{quote}
  \vskip 1ex
}

% Section formatting
\renewcommand\section{\@startsection{section}{1}{\z@}%
  {-2.0ex \@plus -0.5ex \@minus -0.2ex}%
  {1.5ex \@plus 0.3ex \@minus 0.2ex}%
  {\large\bf\raggedright}}
\renewcommand\subsection{\@startsection{subsection}{2}{\z@}%
  {-1.8ex \@plus -0.5ex \@minus -0.2ex}%
  {0.8ex \@plus 0.2ex}%
  {\normalsize\bf\raggedright}}
\renewcommand\subsubsection{\@startsection{subsubsection}{3}{\z@}%
  {-1.5ex \@plus -0.5ex \@minus -0.2ex}%
  {0.5ex \@plus 0.2ex}%
  {\normalsize\bf\raggedright}}
\renewcommand\paragraph{\@startsection{paragraph}{4}{\z@}%
  {1.5ex \@plus 0.5ex \@minus 0.2ex}{-1em}%
  {\normalsize\bf}}

% Spacing
\setlength{\parindent}{0pt}
\setlength{\parskip}{5.5pt plus 1pt minus 1pt}

\endinput
